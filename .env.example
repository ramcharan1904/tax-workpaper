# Copy to .env and fill in. Never commit .env.

# Neon POOLED connection (hostname contains -pooler). Used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon DIRECT connection (no -pooler). Used by the loader and schema changes.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# Encrypts SSNs, account numbers and the raw packet copy. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means the encrypted values cannot be read again: keep a copy safe.
ENCRYPTION_KEY=
